---
import BaseLayout from '~/layouts/BaseLayout.astro';
import IndexVisual from '~/components/index/IndexVisual.astro';
import TopologyDiagram from '~/components/mediflow/TopologyDiagram.astro';
import { indexEntries } from '~/data/index';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const fmt = (date: Date) =>
  date.toLocaleDateString('it-IT', { year: 'numeric', month: 'long', day: 'numeric' });

const references = indexEntries.slice(0, 3);
---

<BaseLayout
  title="leonardopegollo.dev"
  description="Leonardo Pegollo: medico di distretto a Milano. Sanità territoriale, dati, software clinico locale e tecnologia usata con giudizio."
>
  <section class="hero">
    <div class="wrap hero-grid">
      <h1 class="reveal">
        Leonardo Pegollo{' '}
        <span>medico, dati e lavoro clinico oggi.</span>
      </h1>

      <div class="hero-copy reveal">
        <p class="lead">
          Faccio il medico di distretto. Lavoro con pazienti complessi,
          domiciliarità e sanità territoriale; quando un problema ritorna spesso,
          provo a rimetterlo in ordine: dati, codice quando serve, un modo più
          ripetibile di arrivare a una risposta. Da lì nasce{' '}
          <a href="/mediflow" class="link-ink">MediFlow</a>, una cartella clinica{' '}
          <span class="sig">locale</span>{' '}che tiene i dati sul computer di chi cura.
        </p>
        <p class="lead muted">
          Nel lavoro clinico di oggi gli strumenti contano: prevenzione, medicina
          d'iniziativa, codice assistito dall'AI. Possono accorciare la distanza fra
          dati, persone e decisioni, ma chiedono umiltà e revisione. Se servono
          solo a produrre contenuto, hanno già perso il punto.
        </p>
      </div>
    </div>
  </section>

  <section class="project-home">
    <div class="wrap">
      <div class="project-head reveal">
        <h2>MediFlow</h2>
        <div>
          <p>
            Una cartella clinica locale, pensata per chi esercita in autonomia e
            per piccoli ambulatori. Tiene la scheda sul computer di chi cura, con
            i contenuti clinici sensibili cifrati. L'AI, quando serve, gira sullo
            stesso dispositivo.
          </p>
          <a class="text-link" href="/mediflow">Apri la scheda →</a>
        </div>
      </div>

      <div class="project-visual reveal">
        <TopologyDiagram reveal={false} />
      </div>
    </div>
  </section>

  {posts.length > 0 && (
    <section class="notes-home">
      <div class="wrap">
        <div class="home-section-head">
          <h2>Note</h2>
          <a href="/blog">Tutte →</a>
        </div>

        <div class="post-list reveal">
          {posts.map((post) => (
            <a class="post-link" href={`/blog/${post.id}`}>
              <div class="meta">{fmt(post.data.pubDate)}</div>
              <div>
                <h3>{post.data.title}</h3>
                <p>{post.data.description}</p>
              </div>
              <div class="arrow" aria-hidden="true">→</div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="index-home">
    <div class="wrap">
      <div class="home-section-head index-heading">
        <div>
          <h2>Index</h2>
          <p>Siti e strumenti che torno a guardare, con una nota su cosa fanno bene e cosa no.</p>
        </div>
        <a href="/index">Apri l’Index →</a>
      </div>

      <div class="reference-grid">
        {references.map((entry) => (
          <a class="reference reveal" href={`/index/${entry.slug}`}>
            <IndexVisual kind={entry.visual} />
            <div>
              <h3>{entry.title}</h3>
              <p>{entry.summary}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  section.hero{ padding:clamp(72px, 10vw, 140px) 0 clamp(78px, 10vw, 138px); }
  .hero-grid{ display:grid; grid-template-columns:minmax(0, .92fr) minmax(360px, .76fr); gap:clamp(54px, 9vw, 130px); align-items:end; }
  .hero h1{ margin:0; max-width:8.5ch; font-size:clamp(3.9rem, 7.8vw, 7.4rem); line-height:.88; letter-spacing:-.035em; }
  .hero h1 span{ display:block; color:var(--ink-2); }
  .hero-copy{ padding-bottom:.4rem; }
  .hero-copy .lead{ margin:0; font-size:clamp(1.05rem, 1.5vw, 1.24rem); }
  .hero-copy .lead + .lead{ margin-top:26px; }

  .project-home{ padding:clamp(64px, 8vw, 108px) 0; }
  .project-head{ display:grid; grid-template-columns:minmax(0, 1fr) minmax(320px, .78fr); gap:clamp(40px, 8vw, 110px); align-items:start; margin-bottom:clamp(38px, 6vw, 72px); }
  .project-head h2{ margin:0; font-size:clamp(3.5rem, 7vw, 6.8rem); line-height:.9; letter-spacing:-.035em; }
  .project-head p{ font-size:1.13rem; line-height:1.65; }
  .text-link,
  .home-section-head a{ color:var(--mint); font-weight:720; text-decoration:none; }
  .text-link:hover,
  .home-section-head a:hover{ text-decoration:underline; text-underline-offset:5px; }
  .project-visual :global(.topo){ padding:0; border:0; border-radius:0; box-shadow:none; }
  .project-visual :global(.topo svg){ padding:clamp(10px, 2vw, 20px); border-radius:0; }
  .project-visual :global(.legend){ padding:12px 0 0; margin-top:0; }

  .notes-home,
  .index-home{ padding:clamp(60px, 8vw, 100px) 0; }
  .home-section-head{ display:flex; align-items:baseline; justify-content:space-between; gap:28px; margin-bottom:32px; }
  .home-section-head h2{ margin:0; font-size:clamp(2.6rem, 5vw, 4.8rem); letter-spacing:-.035em; }
  .index-heading{ align-items:flex-end; }
  .index-heading p{ max-width:560px; margin:18px 0 0; }
  .index-heading > a{ flex:0 0 auto; }
  .reference-grid{ display:grid; grid-template-columns:1.2fr .9fr .9fr; gap:16px; }
  .reference{ display:flex; flex-direction:column; min-width:0; border:1px solid var(--line); color:inherit; text-decoration:none; transition:border-color var(--dur-1) var(--ease), transform var(--dur-1) var(--ease); }
  .reference:hover{ border-color:var(--ink-2); transform:translateY(-2px); }
  .reference :global(.index-visual){ min-height:220px; }
  .reference:first-child :global(.index-visual){ min-height:300px; }
  .reference > div:last-child{ padding:24px; }
  .reference h3{ margin:0 0 10px; font-size:1.25rem; letter-spacing:-.02em; }
  .reference p{ margin:0; font-size:.95rem; }

  @media (max-width:900px){
    .hero-grid,
    .project-head{ grid-template-columns:1fr; }
    .hero h1{ max-width:9ch; }
    .hero-copy{ max-width:680px; margin-left:auto; }
    .project-head > div{ max-width:620px; margin-left:auto; }
    .reference-grid{ grid-template-columns:repeat(2, minmax(0,1fr)); }
    .reference:first-child{ grid-column:1 / -1; }
  }
  @media (max-width:620px){
    section.hero{ padding-top:64px; }
    .hero h1{ font-size:clamp(3.3rem, 17vw, 5rem); }
    .hero-grid{ gap:48px; }
    .project-head h2{ font-size:clamp(3.2rem, 16vw, 5.4rem); }
    .home-section-head,
    .index-heading{ align-items:flex-start; flex-direction:column; }
    .reference-grid{ grid-template-columns:1fr; }
    .reference:first-child{ grid-column:auto; }
    .reference:hover{ transform:none; }
  }
</style>
