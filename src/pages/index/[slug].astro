---
import BaseLayout from '~/layouts/BaseLayout.astro';
import IndexVisual from '~/components/index/IndexVisual.astro';
import { indexEntries, type IndexEntry } from '~/data/index';

export function getStaticPaths() {
  return indexEntries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

interface Props {
  entry: IndexEntry;
}

const { entry } = Astro.props;
---

<BaseLayout title={entry.title} description={entry.summary}>
  <article class="index-detail">
    <div class="wrap">
      <a class="back-link" href="/index">← Index</a>

      <header class="detail-head">
        <h1>{entry.title}</h1>
        <div>
          <p class="lead">{entry.summary}</p>
          <a class="source-link" href={entry.url} target="_blank" rel="noopener noreferrer">
            Apri {entry.title} <span aria-hidden="true">↗</span>
          </a>
        </div>
      </header>

      <div class="detail-visual">
        <IndexVisual kind={entry.visual} />
      </div>

      <div class="detail-notes">
        <section>
          <h2>Perché c’è</h2>
          <p>{entry.why}</p>
        </section>

        <section>
          <h2>Da guardare</h2>
          <ul>
            {entry.observe.map((item) => <li>{item}</li>)}
          </ul>
        </section>

        <section>
          <h2>Da portare altrove</h2>
          <p>{entry.transferable}</p>
        </section>

        <section>
          <h2>Limiti</h2>
          <p>{entry.limits}</p>
        </section>
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .index-detail{ padding:clamp(54px, 8vw, 100px) 0 var(--space-20); }
  .back-link{ color:var(--ink-1); text-decoration:none; font-weight:680; }
  .back-link:hover{ color:var(--mint); }
  .detail-head{ display:grid; grid-template-columns:minmax(0, 1.2fr) minmax(300px, .8fr); gap:clamp(36px, 8vw, 120px); align-items:end; margin-top:clamp(70px, 10vw, 130px); }
  .detail-head h1{ max-width:8ch; margin:0; font-size:clamp(4rem, 9vw, 8rem); line-height:.88; letter-spacing:-.035em; }
  .detail-head .lead{ margin:0; }
  .source-link{ display:inline-block; margin-top:26px; color:var(--mint); font-weight:720; text-decoration:none; }
  .source-link:hover{ text-decoration:underline; text-underline-offset:5px; }
  .detail-visual{ margin-top:clamp(54px, 8vw, 96px); }
  .detail-visual :global(.index-visual){ min-height:clamp(340px, 52vw, 640px); }
  .detail-notes{ display:grid; grid-template-columns:repeat(2, minmax(0,1fr)); margin-top:clamp(54px, 8vw, 96px); border-top:1px solid var(--line); border-left:1px solid var(--line); }
  .detail-notes section{ min-height:260px; padding:clamp(24px, 4vw, 46px); border-right:1px solid var(--line); border-bottom:1px solid var(--line); }
  .detail-notes h2{ font-size:1.25rem; letter-spacing:-.02em; }
  .detail-notes p,
  .detail-notes li{ color:var(--ink-1); line-height:1.65; }
  .detail-notes ul{ margin:18px 0 0; padding-left:20px; }
  .detail-notes li + li{ margin-top:8px; }

  @media (max-width:760px){
    .detail-head{ grid-template-columns:1fr; align-items:start; }
    .detail-head h1{ max-width:10ch; }
    .detail-notes{ grid-template-columns:1fr; }
    .detail-notes section{ min-height:0; }
  }
</style>
