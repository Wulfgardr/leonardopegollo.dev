---
import BaseLayout from '~/layouts/BaseLayout.astro';
import IndexVisual from '~/components/index/IndexVisual.astro';
import { indexEntries } from '~/data/index';

const [featured, ...remaining] = indexEntries;
const middle = remaining.slice(0, 4);
const closing = remaining.at(-1);
---

<BaseLayout
  title="Index"
  description="Siti e strumenti che Leonardo Pegollo torna a guardare, con una nota su cosa fanno bene e cosa no."
>
  <section class="index-intro">
    <div class="wrap">
      <h1>Index</h1>
      <p class="lead">
        Siti e strumenti che torno a guardare, con una nota su cosa fanno bene
        e cosa no.
      </p>
    </div>
  </section>

  <section class="index-collection">
    <div class="wrap">
      <a class="index-card index-card--featured reveal" href={`/index/${featured.slug}`}>
        <IndexVisual kind={featured.visual} />
        <div class="index-copy">
          <h2>{featured.title}</h2>
          <p>{featured.summary}</p>
          <span class="index-arrow" aria-hidden="true">Leggi la nota →</span>
        </div>
      </a>

      <div class="index-grid">
        {middle.map((entry) => (
          <a class="index-card reveal" href={`/index/${entry.slug}`}>
            <IndexVisual kind={entry.visual} />
            <div class="index-copy">
              <h2>{entry.title}</h2>
              <p>{entry.summary}</p>
              <span class="index-arrow" aria-hidden="true">Leggi la nota →</span>
            </div>
          </a>
        ))}
      </div>

      {closing && (
        <a class="index-card index-card--closing reveal" href={`/index/${closing.slug}`}>
          <div class="index-copy">
            <h2>{closing.title}</h2>
            <p>{closing.summary}</p>
            <span class="index-arrow" aria-hidden="true">Leggi la nota →</span>
          </div>
          <IndexVisual kind={closing.visual} />
        </a>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .index-intro{ padding:clamp(72px, 10vw, 136px) 0 clamp(54px, 8vw, 96px); }
  .index-intro h1{ font-size:clamp(4.8rem, 12vw, 9.6rem); line-height:.84; letter-spacing:-.035em; }
  .index-intro .lead{ max-width:620px; margin:34px 0 0 auto; font-size:clamp(1.15rem, 2vw, 1.5rem); }

  .index-collection{ padding:0 0 var(--space-20); border-top:0; }
  .index-card{
    display:grid;
    grid-template-rows:auto 1fr;
    min-width:0;
    color:inherit;
    background:var(--surface);
    border:1px solid var(--line);
    text-decoration:none;
    transition:border-color var(--dur-1) var(--ease), transform var(--dur-1) var(--ease);
  }
  .index-card:hover{ border-color:var(--ink-2); transform:translateY(-2px); }
  .index-card--featured,
  .index-card--closing{ grid-template-columns:minmax(0, 1.35fr) minmax(300px, .65fr); grid-template-rows:none; }
  .index-card--featured .index-visual{ min-height:430px; }
  .index-card--closing{ grid-template-columns:minmax(300px, .65fr) minmax(0, 1.35fr); margin-top:16px; }
  .index-card--closing .index-visual{ min-height:320px; }
  .index-copy{ display:flex; flex-direction:column; align-items:flex-start; padding:clamp(24px, 4vw, 48px); }
  .index-copy h2{ margin:auto 0 14px; font-size:clamp(1.8rem, 3vw, 2.7rem); letter-spacing:-.025em; }
  .index-copy > p{ max-width:42ch; margin:0; }
  .index-arrow{ margin-top:28px; color:var(--mint); font-weight:720; }
  .index-grid{ display:grid; grid-template-columns:repeat(2, minmax(0,1fr)); gap:16px; margin-top:16px; }
  .index-grid .index-copy{ min-height:280px; }

  @media (max-width:820px){
    .index-card--featured,
    .index-card--closing{ grid-template-columns:1fr; grid-template-rows:auto 1fr; }
    .index-card--closing .index-copy{ order:2; }
    .index-card--closing .index-visual{ order:1; }
    .index-card--featured .index-visual,
    .index-card--closing .index-visual{ min-height:280px; }
  }
  @media (max-width:620px){
    .index-intro h1{ font-size:clamp(4rem, 22vw, 6.8rem); }
    .index-intro .lead{ margin-left:0; }
    .index-grid{ grid-template-columns:1fr; }
    .index-grid .index-copy{ min-height:240px; }
    .index-card:hover{ transform:none; }
  }
</style>
