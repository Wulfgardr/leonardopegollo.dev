---
import BaseLayout from '~/layouts/BaseLayout.astro';
import SectionHead from '~/components/SectionHead.astro';
import Card from '~/components/Card.astro';
import CardGrid from '~/components/CardGrid.astro';
import PullQuote from '~/components/PullQuote.astro';
import TopologyDiagram from '~/components/mediflow/TopologyDiagram.astro';

// Contenuti per-sezione: le card sono pura informazione, quindi vivono in array
// e si modificano in un punto solo.
const perchiMedico = [
  { title: `Cosa vede ogni giorno`, body: `La scheda clinica con la storia coerente: diagnosi codificate, terapie con principio attivo e ATC, controlli passati e in agenda, osservazioni con unità di misura standard, allegati con riassunto.` },
  { title: `Cosa cambia rispetto al solito`, body: `I dati non sono in un servizio remoto: sono nel suo computer. L'AI lo aiuta ma non scrive nulla in scheda senza una sua conferma esplicita, soprattutto su diagnosi e terapie.` },
  { title: `Cosa non gli viene chiesto`, body: `Niente account su servizi terzi, niente abbonamenti per usare l'AI, niente caricamento di referti sul cloud. Il PIN sblocca la sessione locale.` },
  { title: `Cosa porta via se cambia idea`, body: `Un pacchetto FHIR R4 con anagrafica, diagnosi, visite, terapie e osservazioni. Standard riconosciuto, leggibile da altri sistemi.` },
];
const perchiPaziente = [
  { title: `Dove finiscono i suoi dati`, body: `Sul computer di chi ha in carico la persona. I contenuti clinici sensibili sono cifrati lato client. Non vengono condivisi con servizi remoti né usati per addestrare modelli.` },
  { title: `Quali diritti restano garantiti`, body: `Diritto all'oblio (Art. 17 GDPR) con cancellazione governata. Portabilità dei dati (Art. 20) tramite esportazione in formato standard.` },
  { title: `Cosa succede se il computer viene rubato`, body: `Senza PIN non si sblocca la sessione e i campi clinici cifrati restano ciphertext. Dispositivo, backup e metadati restano comunque parte del perimetro da proteggere.` },
  { title: `Chi è responsabile`, body: `Il professionista resta titolare del trattamento. MediFlow è lo strumento, non l'esecutore.` },
];
const perchiAmm = [
  { title: `Modello di dispiegamento`, body: `Single-tenant locale. Un nodo per professionista. Niente server centrale da mantenere, niente perimetro multi-paziente da difendere a livello di rete.` },
  { title: `Compatibilità con il SSR`, body: `Boundary espliciti verso SISS/FSE: oggi MediFlow prepara il contesto e richiama i percorsi ufficiali in modalità assistita. Niente claim di integrazione regionale certificata fuori da quanto documentato.` },
  { title: `Auditing`, body: `Registro append-only con catalogo eventi limitato (chi, cosa, quando, esito). Niente PHI nei log applicativi, niente testi liberi clinici fuori dal record.` },
  { title: `Costi nascosti`, body: `Nessun canone per AI cloud. Nessun lock-in proprietario di formato dati: l'export FHIR R4 e la cifratura aperta tengono basso il costo di uscita.` },
];
const principi = [
  { numeral: 'I', tag: `default`, title: `Locale prima di tutto`, body: `I dati clinici non escono dal computer per impostazione predefinita. Niente telemetria, niente sincronizzazione automatica, niente chiamate AI verso servizi esterni. Se una funzione richiedesse un canale remoto, viene aggiunta in modo esplicito, documentata e disattivabile.` },
  { numeral: 'II', tag: `cifratura`, title: `Cifratura lato client`, body: `I campi clinici sensibili sono cifrati lato client con AES-256-GCM prima della scrittura. Il PIN non viene mai salvato. La chiave principale viene sbloccata dalla chiave derivata dal PIN, custodita in memoria solo durante la sessione e mai sul disco. Nessun ripristino possibile in caso di smarrimento del PIN: è una garanzia, non un bug.` },
  { numeral: 'III', tag: `interoperabilità`, title: `Standard aperti`, body: `ICD-11 per le diagnosi, ATC e AIC per i farmaci, LOINC e UCUM per le osservazioni, FHIR R4 per l'esportazione. Niente formato proprietario quando esiste un formato condiviso a livello internazionale.` },
  { numeral: 'IV', tag: `no automatismi`, title: `AI revisionabile`, body: `I modelli locali aiutano nella sintesi, nell'OCR e nei suggerimenti. Non scrivono mai diagnosi o terapie senza una conferma esplicita di chi esercita. L'unica eccezione documentata è l'autofill su codici ICD letteralmente presenti nel documento sorgente.` },
];
const topoCards = [
  { title: `Un nodo, non un servizio`, body: `Nel ramo 0.7.1 il Mac diventa il nodo autorevole: contiene il database, espone l'API, governa runtime e backup. Niente server centrale.` },
  { title: `Tre superfici API distinte`, body: `Web API per il browser, Native API versionata per i client Apple, Network API opzionale per i client paired in LAN fidata. Capability e versioni restano esplicite.` },
  { title: `Core condiviso, app per piattaforma`, body: `MediFlowCore porta contratti, filtri, cifratura e logica clinica fuori dalla UI. Linux e Windows verificano core e launcher, non promettono app desktop complete.` },
];
const interop = [
  { title: `ICD-11`, body: `Diagnosi codificate secondo il sistema OMS, via API locale. Niente più testo libero ambiguo.` },
  { title: `FHIR R4`, body: `Esportazione della cartella in pacchetto JSON HL7 FHIR R4: Patient, Condition, Encounter, MedicationStatement, Observation.` },
  { title: `ATC · AIC`, body: `Catalogo farmaci AIFA locale per terapie con principio attivo e codice di identificazione.` },
  { title: `LOINC · UCUM`, body: `Codifica delle osservazioni con unità di misura standardizzate.` },
];
const boundary = [
  { title: `Niente sincronizzazione cloud completa`, body: `Non sincronizziamo le cartelle attraverso Internet con un servizio centrale. La modalità Mac home-base copre solo la rete locale fidata, in opt-in, con scrittura limitata e versionata.` },
  { title: `Niente multi-tenant centralizzato`, body: `MediFlow non è un servizio condiviso fra strutture. È un'app per chi esercita in autonomia o per piccoli ambulatori che operano sotto la responsabilità di chi cura.` },
  { title: `Niente AI cloud di default`, body: `L'unica eccezione documentata è una lane interna di valutazione comparativa, opt-in, mai usata come runtime clinico, mai con dati paziente non redatti.` },
  { title: `Niente integrazione regionale fuori boundary`, body: `Verso SISS/FSE oggi MediFlow prepara il contesto e richiama i percorsi ufficiali in modalità assistita. Niente UI regionale custom dentro il prodotto fino a una qualifica documentata.` },
  { title: `Niente automatismi clinici al buio`, body: `L'AI non scrive diagnosi e terapie senza conferma. L'unico autofill ammesso è su codici ICD letteralmente presenti nel documento sorgente.` },
  { title: `Niente telemetria silenziosa`, body: `Nessun ping a servizi remoti per uso. Nessun analytics. Nessun beacon. Niente.` },
];
---
<BaseLayout
  title="MediFlow · scheda prodotto"
  description="MediFlow: cartella clinica locale, con campi clinici cifrati e AI sul dispositivo. Cosa è, come funziona, dove va."
>
  <!-- Sotto-navigazione interna della scheda MediFlow -->
  <div class="wp-subnav-wrap">
    <nav class="wp-subnav" aria-label="Indice della scheda MediFlow">
      <div class="wrap">
        <ol>
          <li><a href="#cosa"><span class="n">01</span>Cos'è</a></li>
          <li><a href="#perchi"><span class="n">02</span>Per chi</a></li>
          <li><a href="#principi"><span class="n">03</span>Principi</a></li>
          <li><a href="#topologia"><span class="n">04</span>Topologia</a></li>
          <li><a href="#flussi"><span class="n">05</span>Flussi</a></li>
          <li><a href="#sicurezza"><span class="n">06</span>Sicurezza</a></li>
          <li><a href="#tappe"><span class="n">07</span>Tappe</a></li>
          <li><a href="#glossario"><span class="n">08</span>Glossario</a></li>
        </ol>
      </div>
    </nav>
  </div>

  <!-- HERO -->
  <section class="hero">
    <div class="wrap">
      <span class="eyebrow">Scheda prodotto · v0.7.1 · Luglio 2026</span>
      <h1 class="gradient-title" style="margin-top:18px">
        MediFlow <span class="h-mute">è una cartella clinica</span><br/><span class="sig">locale</span>, per lavorare senza spedire i dati altrove.
      </h1>
      <p class="lead" style="max-width:720px; margin-top:24px">
        MediFlow è pensata per chi esercita in autonomia e per piccoli ambulatori.
        Tiene la scheda sul computer di chi cura, con i contenuti clinici sensibili cifrati. L'AI, quando serve,
        gira sullo stesso dispositivo. Con la 0.7.1 il Mac è il nodo home-base più avanzato; iPhone e iPad
        restano client accoppiati e revisionabili. Per uscire da MediFlow ci sono formati standard:
        ICD-11 per le diagnosi, FHIR per l'esportazione.
      </p>
      <div style="display:flex; gap:10px; margin-top:30px; flex-wrap:wrap">
        <a class="btn btn-primary" href="#cosa">Leggi la scheda <span aria-hidden="true">→</span></a>
        <a class="btn btn-ghost" href="#tappe">Dove stiamo andando</a>
      </div>

      <div class="chip-row hero-meta" aria-label="Coordinate MediFlow">
        <span class="chip">Dati sul computer</span>
        <span class="chip">PIN e cifratura</span>
        <span class="chip">AI locale, opzionale</span>
        <span class="chip">Mac home-base</span>
        <span class="chip">Export FHIR R4</span>
      </div>

      <div class="strip" aria-hidden="true">
        <span><b>Local-first</b></span>
        <span><b>AES-256-GCM</b></span>
        <span><b>Niente telemetria</b></span>
        <span><b>Open source</b></span>
        <span><b>v0.7.1</b></span>
        <span><b>Audit append-only</b></span>
        <span><b>FHIR R4</b></span>
      </div>
    </div>
  </section>

  <!-- COSA È -->
  <section id="cosa">
    <div class="wrap">
      <SectionHead
        heading="Una cartella clinica, niente di più. Niente di meno."
        lead="MediFlow gestisce anagrafica, diario clinico, terapie, controlli, osservazioni e documenti delle persone in cura. Lo fa senza chiedere a chi cura di affidare i dati a un servizio remoto e senza promettere miracoli che non può mantenere."
      />

      <CardGrid cols={3} reveal>
        <Card ord="01" title="Una scheda paziente coerente" body="Anagrafica, diagnosi codificate, terapie, esami, osservazioni, allegati. Tutto in un unico posto, con i contenuti clinici sensibili cifrati.">
          <svg slot="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <rect x="6" y="4" width="12" height="17" rx="2"/>
            <path d="M9 4v-1h6v1"/>
            <path d="M9 10h6M9 14h6M9 17h4"/>
          </svg>
        </Card>
        <Card ord="02" title="AI che lavora con te" body="Riassunti documentali, suggerimenti di codifica ICD-11 a partire dai referti, lettura testuale dei PDF. Sempre revisionabile, mai automatica al buio.">
          <svg slot="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 13l3-3 3 3 3-6 3 6 4-8"/>
            <path d="M4 19h16"/>
          </svg>
        </Card>
        <Card ord="03" title="Una sessione sbloccata dal PIN" body="Il PIN sblocca la chiave della sessione locale. I campi clinici sensibili restano cifrati sul disco; dispositivo e backup restano nel perimetro operativo da proteggere.">
          <svg slot="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <rect x="5" y="11" width="14" height="9" rx="2"/>
            <path d="M8 11V7a4 4 0 0 1 8 0v4"/>
            <circle cx="12" cy="15.5" r="1" fill="currentColor"/>
          </svg>
        </Card>
        <Card ord="04" title="Salvataggi automatici" body="Backup notturno governato, ritenzione configurabile, manifesto e controllo preliminare prima del ripristino.">
          <svg slot="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 7l9-4 9 4-9 4-9-4z"/>
            <path d="M3 7v10l9 4 9-4V7"/>
            <path d="M12 11v10"/>
          </svg>
        </Card>
        <Card ord="05" title="Multi-ambulatorio" body="Più sedi e reparti distinguibili a colpo d'occhio. Permette di gestire più contesti senza confondere le persone in cura.">
          <svg slot="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <rect x="4" y="5" width="16" height="15" rx="1.5"/>
            <path d="M9 20v-5h6v5"/>
            <path d="M12 8v4M10 10h4"/>
          </svg>
        </Card>
        <Card ord="06" title="Esci quando vuoi" body="Esportazione FHIR R4 della storia clinica. Niente trappola: i tuoi dati restano riusabili anche fuori da MediFlow.">
          <svg slot="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 8a8 8 0 0 1 13.6-5L20 5"/>
            <path d="M20 16a8 8 0 0 1-13.6 5L4 19"/>
            <path d="M16 4h4v4"/>
            <path d="M8 20H4v-4"/>
          </svg>
        </Card>
      </CardGrid>

      <div class="divider"></div>

      <PullQuote cite="Principio operativo">«MediFlow è uno strumento. Il titolare del trattamento resta chi cura. Il software non sostituisce le sue responsabilità: gli dà solo gli attrezzi giusti per esercitarle.»</PullQuote>
    </div>
  </section>

  <!-- PER CHI -->
  <section id="perchi">
    <div class="wrap">
      <SectionHead
        heading="Tre punti di vista, una stessa cartella."
        lead="Il prodotto cambia di significato a seconda di chi lo guarda. Ecco cosa cambia per ciascuno."
      />

      <div class="reveal">
        <div class="tabs" role="tablist" aria-label="Pubblico">
          <button class="active" data-tab="medico" role="tab" aria-selected="true">Medico</button>
          <button data-tab="paziente" role="tab" aria-selected="false">Paziente</button>
          <button data-tab="amministrazione" role="tab" aria-selected="false">Amministrazione &amp; IT</button>
        </div>

        <div class="panel active" data-panel="medico">
          <CardGrid cols={2}>
            {perchiMedico.map((c) => <Card title={c.title} body={c.body} />)}
          </CardGrid>
        </div>

        <div class="panel" data-panel="paziente">
          <CardGrid cols={2}>
            {perchiPaziente.map((c) => <Card title={c.title} body={c.body} />)}
          </CardGrid>
        </div>

        <div class="panel" data-panel="amministrazione">
          <CardGrid cols={2}>
            {perchiAmm.map((c) => <Card title={c.title} body={c.body} />)}
          </CardGrid>
        </div>
      </div>
    </div>
  </section>

  <!-- PRINCIPI -->
  <section id="principi">
    <div class="wrap">
      <SectionHead
        heading="Quattro promesse non negoziabili."
        lead="Sono quattro vincoli che pesano sulle scelte tecniche e di prodotto. Quando entrano in conflitto con la velocità di sviluppo, vincono i vincoli."
      />

      <CardGrid cols={2} reveal class="principi">
        {principi.map((p) => <Card class="principio" numeral={p.numeral} tag={p.tag} title={p.title} body={p.body} />)}
      </CardGrid>
    </div>
  </section>

  <!-- TOPOLOGIA -->
  <section id="topologia">
    <div class="wrap">
      <SectionHead
        heading="Dove vivono i dati. Chi parla con chi."
        lead="Il sistema gira sul Mac di chi cura. Il browser e i client Apple parlano con un'unica applicazione locale; il core condiviso viene verificato anche su Linux e Windows. I servizi opzionali restano locali o esplicitamente valutativi."
      />

      <TopologyDiagram />

      <CardGrid cols={3} reveal style="margin-top:30px">
        {topoCards.map((c) => <Card title={c.title} body={c.body} />)}
      </CardGrid>
    </div>
  </section>

  <!-- FLUSSI -->
  <section id="flussi">
    <div class="wrap">
      <SectionHead
        heading="Cosa succede davvero quando lavori in scheda."
        lead="Sei flussi essenziali, in ordine di vita di una giornata clinica. La 0.7.1 consolida il Mac come base operativa e mantiene i client paired dentro capability esplicite."
      />

      <div class="flow-list reveal">
        <div class="flow"><div class="step">FLUSSO · 01</div><div class="body"><h4>Sblocco e attivazione delle chiavi</h4><p>Il professionista inserisce il PIN. Dal PIN si deriva una chiave intermedia, che a sua volta sblocca la chiave principale, mantenuta in memoria solo per la sessione attiva. Nessuna delle due viene salvata sul disco.</p></div></div>
        <div class="flow"><div class="step">FLUSSO · 02</div><div class="body"><h4>Scrittura clinica dal browser</h4><p>I campi sensibili (note, allegati, riassunti AI) vengono cifrati nel browser prima di partire verso l'API. Sul disco arrivano solo stringhe nella forma <code>ENC:iv:cipher</code>. Il server non vede mai il testo in chiaro.</p></div></div>
        <div class="flow"><div class="step">FLUSSO · 03</div><div class="body"><h4>Lettura/scrittura dal client macOS nativo</h4><p>Il client Apple cifra in locale, parla in HTTPS verso il proxy TLS sulla porta 3443, presenta un token bearer su un'API versionata <code>/api/v1/*</code>. Niente scraping della UI, niente dipendenza dai dettagli interni del web.</p></div></div>
        <div class="flow"><div class="step">FLUSSO · 04</div><div class="body"><h4>Documento → OCR → sintesi → archivio</h4><p>Il referto caricato passa al servizio OCR locale (Ollama), che lo rende testo. Un secondo passaggio AI estrae sintesi, qualità del segnale e codici ICD esplicitamente presenti. Il risultato viene cifrato e attaccato alla scheda clinica come allegato + artefatto di evidenza.</p></div></div>
        <div class="flow"><div class="step">FLUSSO · 05</div><div class="body"><h4>Smart import revisionabile</h4><p>Dal profilo paziente l'AI propone diagnosi e terapie a partire dalle fonti già presenti (note, diario, allegati analizzati). Le proposte sono associate a evidenze e attendono conferma esplicita. Nessuna scrittura in scheda senza un click consapevole.</p></div></div>
        <div class="flow"><div class="step">FLUSSO · 06</div><div class="body"><h4>Modalità Mac home-base con client paired</h4><p>Se attivata in modo esplicito, la modalità rete consente a un iPhone o iPad accoppiato di consultare e aggiornare in modo limitato profilo, diario, terapie, controlli e osservazioni. Ogni scrittura richiede capability dedicate, sessione operatore e numero di versione: in caso di conflitto il server risponde con un esplicito errore di versione.</p></div></div>
      </div>
    </div>
  </section>

  <!-- SICUREZZA -->
  <section id="sicurezza">
    <div class="wrap">
      <SectionHead
        heading="Cosa proteggiamo. Da chi. Come."
        lead="Il modello di minaccia è esplicito: descriviamo cosa copriamo e cosa non copriamo. La sicurezza non è una promessa, è un perimetro."
      />

      <CardGrid cols={2} reveal>
        <Card title="Cosa copriamo">
          <p style="margin-bottom:10px">Il modello assume che un attaccante possa:</p>
          <ul style="color:var(--ink-1); font-size:14.5px; padding-left:18px"><li>ottenere il file del database (furto del disco, leak di un backup)</li><li>leggere log applicativi, screenshot o crash report</li><li>annusare il traffico locale verso i client</li></ul>
          <p style="margin-top:14px">Per ognuno dei tre, la cifratura a riposo, la redazione dei log e il proxy TLS locale forniscono una difesa esplicita.</p>
        </Card>
        <Card title="Cosa non copriamo" body="Un sistema operativo completamente compromesso (con keylogger e accesso alla memoria) e un attacco fisico a dispositivo già sbloccato sono fuori dal modello. In quei casi nessun software locale può proteggere efficacemente i dati." />
        <Card title="Cifratura"><p>AES-256-GCM lato client. Formato di campo cifrato esplicito (<code>ENC:iv:cipher</code>). KDF: PBKDF2-SHA256 da PIN + salt utente. La chiave principale è cifrata sotto la KEK derivata dal PIN ed è leggibile solo durante una sessione attiva.</p></Card>
        <Card title="Lockout autenticazione"><p>Cinque tentativi falliti in quindici minuti attivano un blocco di pari durata. Risposte standard: <code>401</code> finché il blocco non scatta, <code>423</code> con header <code>Retry-After</code> durante il blocco. Il bearer token nativo non aggira la policy: il PIN è la barriera condivisa.</p></Card>
        <Card title="Logging e redazione" body="I log applicativi non contengono mai campi paziente decifrati, OCR grezzo, prompt AI completi o allegati. L'audit clinico è separato dai log tecnici: è strutturato, versionato e append-only, con catalogo di eventi minimo." />
        <Card title="Boundary verso servizi esterni"><p>I proxy locali accettano solo destinazioni su <code>127.0.0.1</code> e porte previste. Ogni risposta dei modelli AI è trattata come input non fidato. Niente import silenziosi da testo libero verso diagnosi o terapie.</p></Card>
      </CardGrid>
    </div>
  </section>

  <!-- INTEROPERABILITÀ -->
  <section id="interop">
    <div class="wrap">
      <SectionHead
        heading="Standard veri, non promesse."
        lead="Ogni dato clinico ha un codice riconosciuto a livello internazionale. Niente vincoli proprietari sui formati di esportazione."
      />

      <CardGrid cols={4} reveal>
        {interop.map((c) => <Card title={c.title} body={c.body} />)}
      </CardGrid>
    </div>
  </section>

  <!-- TAPPE -->
  <section id="tappe">
    <div class="wrap">
      <SectionHead
        heading="Roadmap pubblica dopo la 0.7.1."
        lead="Non serve una cronologia completa per capire MediFlow: conta distinguere cosa è nella release corrente, cosa è in consolidamento e cosa resta una soglia futura."
      />

      <div class="timeline reveal">
        <div class="tl-item"><div class="ver"><b>v0.7.1</b> · mainline corrente</div><h4>Cartella web locale, Mac home-base e runtime verificabile</h4><ul><li>Web app locale come superficie clinica primaria su Mac</li><li>Campi clinici sensibili cifrati lato client dentro SQLite locale</li><li>Runtime panel, backup governati, audit append-only e lockout autenticazione</li><li>Launcher e core verificati anche su Linux e Windows, senza dichiarare app desktop complete</li></ul></div>
        <div class="tl-item"><div class="ver"><b>Apple native</b> · consolidamento</div><h4>Mac nodo autorevole, iPhone e iPad come client paired</h4><ul><li>Pairing esplicito su rete locale fidata</li><li>Capability discovery e scritture versionate limitate</li><li>MediFlowCore condiviso per logica clinica, contratti, filtri e cifratura</li><li>UI Apple con Vetro Clinico/Liquid Glass dove la piattaforma lo consente</li></ul></div>
        <div class="tl-item"><div class="ver"><b>Document intelligence</b> · review-first</div><h4>OCR, sintesi e assorbimento evidenza senza automatismi clinici</h4><ul><li>Smart Import e nuova anagrafica da documento restano revisionabili</li><li>Artifact <code>parse/evidence</code> cifrati sugli allegati</li><li>Fallback OCR Apple Vision solo su macOS quando il primario locale è low-signal</li><li>Voice visit e trascrizione restano review-first prima di ogni scrittura clinica</li></ul></div>
        <div class="tl-item"><div class="ver"><b>Boundary regionali</b> · handoff assistito</div><h4>SISS/FSE dentro il perimetro documentato</h4><ul><li>MediFlow prepara il contesto e richiama i percorsi ufficiali</li><li>Niente integrazione regionale nativa certificata dichiarata senza qualifica <code>SSI/A2A</code></li><li>Prescrizioni di prestazione separate dalle terapie farmacologiche</li><li>Matching repertorio reviewable, non spacciato per invio regionale</li></ul></div>
        <div class="tl-item future"><div class="ver"><b>Prossima soglia</b> <span class="pill">in corso</span></div><h4>Rete più ampia, packaging e voce</h4><ul><li>Replica e fallback offline tra dispositivi con riconciliazione esplicita</li><li>Runtime AI locale centralizzabile per i client meno potenti, senza egress</li><li>Packaging Windows/Linux limitato al runtime condiviso finché non esiste una UX desktop dedicata</li><li>Prescrizioni di prestazione locali e dettatura/chat vocale, sempre review-first</li></ul></div>
        <div class="tl-item future"><div class="ver"><b>Visione</b> <span class="pill">futura</span></div><h4>Un ecosistema clinico locale, aperto, installabile</h4><ul><li>Esperienza nativa multi-dispositivo coerente sotto un unico contratto</li><li>Integrazione SISS/FSE solo se qualificata e sostenibile</li><li>Contratti di esportazione e migrazione formalizzati</li></ul></div>
      </div>
    </div>
  </section>

  <!-- BOUNDARY -->
