---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = (await getCollection('blog')).filter((p) => import.meta.env.DEV || !p.data.draft);
  return posts.map((p) => ({
    params: { slug: p.id },
    props: { post: p },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const fmt = (d: Date) =>
  d.toLocaleDateString('it-IT', { year: 'numeric', month: 'long', day: 'numeric' });
---
<BaseLayout title={post.data.title} description={post.data.description}>
  <section style="padding-top:50px">
    <div class="wrap-narrow">
      <p style="margin:0 0 24px"><a class="back" href="/blog">← Tutti i post</a></p>

      <article class="article">
        <header>
          <div class="meta">
            {fmt(post.data.pubDate)}
            {post.data.updatedDate && <span> · aggiornato {fmt(post.data.updatedDate)}</span>}
            {post.data.tags.length > 0 && <span> · {post.data.tags.join(' · ')}</span>}
          </div>
          <h1 transition:name={`post-title-${post.id}`}>{post.data.title}</h1>
          {post.data.description && <p class="standfirst">{post.data.description}</p>}
        </header>
        <Content />
      </article>

      <div class="divider"></div>
      <p style="margin-top:8px"><a class="back" href="/blog">← Torna a tutti i post</a></p>
    </div>
  </section>
</BaseLayout>

<style>
  .back{
    color:var(--ink-2); text-decoration:none;
    font-family:var(--font-technical); font-size:13px;
    transition:color var(--dur-1) var(--ease);
  }
  .back:hover{ color:var(--ink-0); }

  .article header .meta{ margin-bottom:18px; }
  .article header .meta + h1{ margin-top:0; }

  .standfirst{
    font-family:var(--font-body);
    font-style:normal;
    font-size:18px;
    line-height:1.62;
    color:var(--ink-1);
    margin:6px 0 0;
    max-width:60ch;
  }

</style>

<style is:global>
  /* I diagrammi dei post sono SVG statici pre-renderizzati a build-time
     (sorgenti in scripts/diagrams/*.mmd): nessun JS lato client, nessuna
     risorsa di terze parti. Cornice scura coerente con la console del sito. */
  .mermaid{
    margin:28px 0;
    padding:14px;
    background:var(--surface);
    border:1px solid var(--line);
    border-radius:var(--r-media);
    overflow:auto;
    text-align:center;
    box-shadow:var(--sh-card);
  }
  .mermaid svg{
    display:block;
    max-width:100%;
    height:auto;
    margin:0 auto;
    padding:18px;
    background:#0d1117;
    border-radius:14px;
  }
  .mermaid svg p{
    color:inherit !important;
    font-weight:inherit;
    line-height:1.3;
  }
  .mermaid svg .label,
  .mermaid svg .nodeLabel,
  .mermaid svg .edgeLabel{
    color:inherit;
  }
  @media (max-width:560px){
    .mermaid{ padding:10px; }
    .mermaid svg{ padding:14px; border-radius:12px; }
  }

  /* Visual PRREG: superfici native del tema corrente, senza SVG o runtime esterni. */
  .prreg-viz{
    margin:34px 0;
    padding:clamp(18px, 3.2vw, 28px);
    color:var(--ink-0);
    background:var(--surface-2);
    border:1px solid var(--line);
    border-radius:var(--r-media);
    overflow:visible;
  }
  .prreg-viz *, .prreg-viz *::before, .prreg-viz *::after{ box-sizing:border-box; }
  .prreg-viz__head{
    display:flex;
    align-items:flex-start;
    justify-content:space-between;
    gap:24px;
    margin-bottom:20px;
    padding-bottom:18px;
    border-bottom:1px solid var(--line);
  }
  .prreg-viz__head h3{ margin:0; font-size:clamp(1.4rem, 3vw, 2rem); }
  .prreg-viz__head p{ margin:7px 0 0; color:var(--ink-2); }
  .prreg-legend{ display:flex; flex-wrap:wrap; gap:6px; }
  .prreg-legend span{
    display:inline-flex;
    align-items:center;
    min-height:30px;
    padding:5px 9px;
    color:var(--ink-2);
    background:var(--surface);
    border:1px solid var(--line);
    border-radius:999px;
    font-family:var(--font-technical);
    font-size:12px;
    line-height:1.25;
  }
  .prreg-legend .observed{ color:var(--mint); border-color:color-mix(in oklab, var(--mint) 45%, var(--line)); }

  .prreg-flow__controls{
    display:flex;
    align-items:center;
    flex-wrap:wrap;
    gap:8px;
    margin-bottom:14px;
  }
  .prreg-flow__controls button{
    min-width:44px;
    min-height:44px;
    padding:9px 13px;
    color:var(--ink-0);
    background:var(--surface);
    border:1px solid var(--line);
    border-radius:var(--r-card);
    font:700 13px/1 var(--font-technical);
    cursor:pointer;
    transition:background var(--dur-1) var(--ease), border-color var(--dur-1) var(--ease), color var(--dur-1) var(--ease);
  }
  .prreg-flow__controls button:hover,
  .prreg-flow__controls button:focus-visible{ border-color:var(--mint); color:var(--mint); }
  .prreg-flow__controls button[aria-pressed="true"]{ color:var(--surface); background:var(--mint); border-color:var(--mint); }
  .prreg-flow__status{
    margin-left:auto;
    color:var(--ink-2);
    font-family:var(--font-technical);
    font-size:12px;
  }
  .prreg-flow__track{
    display:grid;
    grid-template-columns:repeat(3, minmax(0, 1fr));
    gap:8px;
    margin:0;
    padding:0;
    list-style:none;
  }
  .prreg-flow__track li{ min-width:0; margin:0; padding:0; }
  .prreg-step{
    display:flex;
    flex-direction:column;
    width:100%;
    min-width:0;
    min-height:118px;
    padding:14px;
    color:var(--ink-1);
    background:var(--surface);
    border:1px solid var(--line);
    border-radius:var(--r-card);
    text-align:left;
    overflow:visible;
    overflow-wrap:break-word;
    word-break:normal;
    cursor:pointer;
    transition:background var(--dur-1) var(--ease), border-color var(--dur-1) var(--ease), transform var(--dur-1) var(--ease);
  }
  .prreg-step:hover{ border-color:color-mix(in oklab, var(--mint) 48%, var(--line)); }
  .prreg-step:focus-visible{ outline:2px solid var(--mint); outline-offset:2px; }
  .prreg-step[aria-pressed="true"]{
    color:var(--ink-0);
    background:color-mix(in oklab, var(--mint) 8%, var(--surface));
    border-color:var(--mint);
    transform:translateY(-2px);
  }
  .prreg-step__n{
    display:block;
    margin-bottom:14px;
    color:var(--mint);
    font-family:var(--font-technical);
    font-size:10px;
    font-weight:760;
    line-height:1.35;
    letter-spacing:.045em;
  }
  .prreg-step strong{ display:block; font-size:14px; line-height:1.25; }
  .prreg-step small{ display:block; margin-top:6px; color:var(--ink-2); font-size:12px; line-height:1.4; }
  .prreg-flow__detail{
    min-height:118px;
    margin-top:12px;
    padding:18px;
    background:var(--surface);
    border-left:3px solid var(--mint);
  }
  .prreg-flow__detail strong{ font-size:1rem; }
  .prreg-flow__detail p{ margin:7px 0 0; color:var(--ink-1); }
  .prreg-viz figcaption{ margin-top:16px; color:var(--ink-2); font-size:13px; line-height:1.55; }

  .prreg-errors{ margin:0; padding:0; list-style:none; }
  .prreg-error{
    display:grid;
    grid-template-columns:minmax(190px, .78fr) minmax(0, 1.45fr);
    gap:clamp(18px, 3vw, 34px);
    margin:0;
    padding:20px 0;
    border-bottom:1px solid var(--line);
  }
  .prreg-error:first-child{ padding-top:0; }
  .prreg-error:last-child{ padding-bottom:0; border-bottom:0; }
  .prreg-error__lead{
    display:grid;
    grid-template-columns:28px minmax(0, 1fr);
    align-content:start;
    gap:10px;
  }
  .prreg-error__lead h4{ margin:0; font-size:1rem; line-height:1.3; text-wrap:balance; }
  .prreg-error__n{ padding-top:3px; color:var(--mint); font:760 11px/1.3 var(--font-technical); }
  .prreg-error__body{ min-width:0; }
  .prreg-error__body p{ margin:0 0 10px; font-size:14px; }
  .prreg-error__body p:last-child{ margin-bottom:0; }
  .prreg-error__body strong{ color:var(--ink-0); }
  .prreg-error__body code{ overflow-wrap:anywhere; word-break:break-word; }

  .prreg-boundary__grid{
    display:grid;
    grid-template-columns:minmax(0, 1fr) 34px minmax(0, 1fr) 34px minmax(0, 1fr);
    align-items:stretch;
    gap:10px;
  }
  .prreg-boundary__card{
    min-width:0;
    padding:18px;
    background:var(--surface);
    border:1px solid var(--line);
    border-radius:var(--r-card);
    overflow-wrap:anywhere;
  }
  .prreg-boundary__card h4{ margin:0 0 8px; font-size:1rem; }
  .prreg-boundary__card p{ margin:0; color:var(--ink-2); font-size:14px; }
  .prreg-boundary__card.observed{ border-color:var(--mint); }
  .prreg-boundary__card.stop{ border-color:color-mix(in oklab, var(--amber) 62%, var(--line)); }
  .prreg-boundary__arrow{ display:grid; place-items:center; color:var(--ink-2); font:700 20px/1 var(--font-technical); }

  @media (max-width:780px){
    .prreg-flow__track{ grid-template-columns:repeat(2, minmax(0, 1fr)); }
    .prreg-error{ grid-template-columns:1fr; gap:12px; }
    .prreg-boundary__grid{ grid-template-columns:1fr; }
    .prreg-boundary__arrow{ min-height:28px; transform:rotate(90deg); }
  }
  @media (max-width:520px){
    .prreg-viz__head{ flex-direction:column; gap:14px; }
    .prreg-flow__status{ width:100%; margin-left:0; }
    .prreg-flow__track{ grid-template-columns:1fr; }
    .prreg-step{ min-height:0; }
    .prreg-flow__detail{ min-height:0; }
  }
  @media (prefers-reduced-motion:reduce){
    .prreg-viz *, .prreg-viz *::before, .prreg-viz *::after{ scroll-behavior:auto !important; transition:none !important; animation:none !important; }
    .prreg-step[aria-pressed="true"]{ transform:none; }
  }
  @media print{
    .prreg-flow__controls{ display:none; }
    .prreg-flow__track{ grid-template-columns:repeat(2, minmax(0, 1fr)); }
    .prreg-flow__detail [hidden]{ display:block !important; margin-top:12px; }
  }
</style>

<script>
  /* @Codex: progressive enhancement per i visual PRREG; il contenuto resta leggibile senza JS. */
  const prregFlowCleanups = new Map<HTMLElement, () => void>();

  const setupPrregFlow = (root: HTMLElement) => {
    const steps = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-prreg-step]'));
    const panels = Array.from(root.querySelectorAll<HTMLElement>('[data-prreg-panel]'));
    const status = root.querySelector<HTMLElement>('[data-prreg-status]');
    const play = root.querySelector<HTMLButtonElement>('[data-prreg-play]');
    const previous = root.querySelector<HTMLButtonElement>('[data-prreg-prev]');
    const next = root.querySelector<HTMLButtonElement>('[data-prreg-next]');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const controller = new AbortController();
    const listenerOptions = { signal: controller.signal };
    let active = 0;
    let timer: number | undefined;

    const stop = () => {
      if (timer !== undefined) window.clearInterval(timer);
      timer = undefined;
      if (play) {
        play.textContent = 'Avvia';
        play.setAttribute('aria-pressed', 'false');
      }
    };
    const select = (index: number, focus = false) => {
      active = (index + steps.length) % steps.length;
      steps.forEach((step, i) => {
        const selected = i === active;
        step.setAttribute('aria-pressed', String(selected));
        step.tabIndex = selected ? 0 : -1;
        if (focus && selected) step.focus();
      });
      panels.forEach((panel, i) => { panel.hidden = i !== active; });
      if (status) status.textContent = `Passaggio ${active + 1} di ${steps.length}`;
    };

    steps.forEach((step, i) => {
      step.addEventListener('click', () => { stop(); select(i); }, listenerOptions);
      step.addEventListener('keydown', (event) => {
        if (event.key === 'ArrowRight') { event.preventDefault(); stop(); select(active + 1, true); }
        if (event.key === 'ArrowLeft') { event.preventDefault(); stop(); select(active - 1, true); }
        if (event.key === 'Home') { event.preventDefault(); stop(); select(0, true); }
        if (event.key === 'End') { event.preventDefault(); stop(); select(steps.length - 1, true); }
      }, listenerOptions);
    });
    previous?.addEventListener('click', () => { stop(); select(active - 1); }, listenerOptions);
    next?.addEventListener('click', () => { stop(); select(active + 1); }, listenerOptions);
    play?.addEventListener('click', () => {
      if (timer !== undefined) return stop();
      if (reduceMotion.matches) return;
      play.textContent = 'Pausa';
      play.setAttribute('aria-pressed', 'true');
      timer = window.setInterval(() => select(active + 1), 1800);
    }, listenerOptions);
    reduceMotion.addEventListener('change', stop, listenerOptions);
    select(0);

    return () => {
      stop();
      controller.abort();
    };
  };

  const cleanupPrregFlows = () => {
    prregFlowCleanups.forEach((cleanup) => cleanup());
    prregFlowCleanups.clear();
  };

  const initPrregFlows = () => {
    cleanupPrregFlows();
    document.querySelectorAll<HTMLElement>('[data-prreg-flow]').forEach((root) => {
      prregFlowCleanups.set(root, setupPrregFlow(root));
    });
  };

  document.addEventListener('astro:before-swap', cleanupPrregFlows);
  document.addEventListener('astro:page-load', initPrregFlows);
  initPrregFlows();
</script>
