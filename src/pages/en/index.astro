---
import BaseLayout from '~/layouts/BaseLayout.astro';
import TopologyDiagram from '~/components/mediflow/TopologyDiagram.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .filter((post) => (import.meta.env.INCLUDE_DRAFTS === 'true' || !post.data.draft) && post.data.lang === 'en')
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const fmt = (date: Date) =>
  date.toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric' });
---

<BaseLayout
  title="leonardopegollo.dev"
  lang="en"
  description="Leonardo Pegollo: a district doctor in Milan. Community healthcare, data, local-first clinical software and technology used with judgement."
  alternates={[{ lang: 'it', path: '/' }, { lang: 'x-default', path: '/' }]}
>
  <section class="hero">
    <div class="wrap hero-grid">
      <h1 class="reveal">
        Leonardo Pegollo{' '}
        <span>doctor, data and clinical work today.</span>
      </h1>

      <div class="hero-copy reveal">
        <p class="lead">
          I work as a district doctor. I work with complex patients, home care and
          community healthcare; when a problem keeps coming back, I try to put it
          back in order: data, code when it helps, a more repeatable way to reach an
          answer. That is where <a href="https://getmediflow.dev/en" class="link-ink">MediFlow</a>{' '}
          comes from: a <span class="sig">local-first</span> medical record that keeps the
          authoritative record on the computer of the person providing care. The work
          on the Intelligence Fabric starts from the same idea: not deciding in the
          abstract that everything must be local or cloud-based, but choosing each time
          according to the work, the data and the risk.
        </p>
        <p class="lead muted">
          In today's clinical work, tools matter: prevention, proactive care and
          AI-assisted code. They can shorten the distance between data, people and
          decisions, but they ask for humility and review. If they only serve to
          produce content, they have already missed the point.
        </p>
      </div>
    </div>
  </section>

  <section class="project-home">
    <div class="wrap">
      <div class="project-head reveal">
        <h2>MediFlow</h2>
        <div>
          <p>
            MediFlow is the open-source practice-management system for outpatient
            patients. It organises records, therapies, documents, measurements and
            follow-up activities, with or without artificial intelligence. Version
            0.8.6, in preparation, reorganises records and documents, guides the
            choice of local models and prepares the Web, macOS and Headless path on
            the Mac. Get MediFlow presents the product, shows how it works and leads
            from the first reading to the details of coding, interoperability and the
            Intelligence Fabric.
          </p>
          <a class="text-link" href="https://getmediflow.dev/en#versione-086">See the 0.8.6 preview →</a>
        </div>
      </div>

      <div class="project-visual reveal">
        <TopologyDiagram reveal={false} lang="en" />
        <p class="muted">General project outline. Version 0.8.6 concerns the Mac; Mini, Windows, Linux, iOS and iPadOS remain on the 1.0 roadmap.</p>
      </div>
    </div>
  </section>

  {posts.length > 0 && (
    <section class="notes-home">
      <div class="wrap">
        <div class="home-section-head">
          <h2>Notes</h2>
          <a href="/en/blog">All →</a>
        </div>

        <div class="post-list reveal">
          {posts.map((post) => (
            <a class="post-link" href={`/en/blog/${post.id}`}>
              <div class="meta">{fmt(post.data.pubDate)}</div>
              <div>
                <h3>{post.data.title}</h3>
                <p>{post.data.description}</p>
              </div>
              <div class="arrow" aria-hidden="true">→</div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

</BaseLayout>

<style>
  section.hero{ padding:clamp(72px, 10vw, 140px) 0 clamp(78px, 10vw, 138px); }
  .hero-grid{ display:grid; grid-template-columns:minmax(0, .92fr) minmax(360px, .76fr); gap:clamp(54px, 9vw, 130px); align-items:end; }
  .hero h1{ margin:0; max-width:8.5ch; font-size:clamp(3.9rem, 7.8vw, 7.4rem); line-height:.88; letter-spacing:-.035em; }
  .hero h1 span{ display:block; color:var(--ink-2); }
  .hero-copy{ padding-bottom:.4rem; }
  .hero-copy .lead{ margin:0; font-size:clamp(1.05rem, 1.5vw, 1.24rem); }
  .hero-copy .lead + .lead{ margin-top:26px; }

  .project-home{ padding:clamp(64px, 8vw, 108px) 0; }
  .project-head{ display:grid; grid-template-columns:minmax(0, 1fr) minmax(320px, .78fr); gap:clamp(40px, 8vw, 110px); align-items:start; margin-bottom:clamp(38px, 6vw, 72px); }
  .project-head h2{ margin:0; font-size:clamp(3.5rem, 7vw, 6.8rem); line-height:.9; letter-spacing:-.035em; }
  .project-head p{ font-size:1.13rem; line-height:1.65; }
  .text-link,
  .home-section-head a{ color:var(--mint); font-weight:720; text-decoration:none; }
  .text-link:hover,
  .home-section-head a:hover{ text-decoration:underline; text-underline-offset:5px; }
  .project-visual :global(.topo){ padding:0; border:0; border-radius:0; box-shadow:none; }
  .project-visual :global(.topo svg){ padding:clamp(10px, 2vw, 20px); border-radius:0; }
  .project-visual :global(.legend){ padding:12px 0 0; margin-top:0; }

  .notes-home{ padding:clamp(60px, 8vw, 100px) 0; }
  .home-section-head{ display:flex; align-items:baseline; justify-content:space-between; gap:28px; margin-bottom:32px; }
  .home-section-head h2{ margin:0; font-size:clamp(2.6rem, 5vw, 4.8rem); letter-spacing:-.035em; }

  @media (max-width:900px){
    .hero-grid,
    .project-head{ grid-template-columns:1fr; }
    .hero h1{ max-width:9ch; }
    .hero-copy{ max-width:680px; margin-left:auto; }
    .project-head > div{ max-width:620px; margin-left:auto; }
  }
  @media (max-width:620px){
    section.hero{ padding-top:64px; }
    .hero h1{ font-size:clamp(3.3rem, 17vw, 5rem); }
    .hero-grid{ gap:48px; }
    .project-head h2{ font-size:clamp(3.2rem, 16vw, 5.4rem); }
    .home-section-head{ align-items:flex-start; flex-direction:column; }
  }
</style>
