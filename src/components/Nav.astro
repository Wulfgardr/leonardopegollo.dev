---
const path = Astro.url.pathname;
function active(prefix: string) {
  if (prefix === '/') return path === '/' || path.startsWith('/mediflow') ? 'page' : undefined;
  return path.startsWith(prefix) ? 'page' : undefined;
}
---
<header class="site-header">
  <div class="nav-shell">
    <a class="brand" href="/" aria-label="leonardopegollo.dev · home">
      <span class="brand-mark" aria-hidden="true"></span>
      <span class="brand-name">leonardopegollo<span>.dev</span></span>
    </a>

    <nav class="links" aria-label="Navigazione principale">
      <a class="nav-row" href="/" aria-current={active('/')}>Lavoro</a>
      <a class="nav-row" href="/blog" aria-current={active('/blog')}>Note</a>
      <a class="nav-row" href="/index" aria-current={active('/index')}>Index</a>
      <a class="nav-row" href="/about" aria-current={active('/about')}>Bio</a>
    </nav>
  </div>
</header>
