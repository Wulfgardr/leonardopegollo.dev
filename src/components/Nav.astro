---
type NavSection = 'work' | 'notes' | 'bio';

const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isWithin = (route: string) => path === route || path.startsWith(`${route}/`);

const currentSection: NavSection | undefined =
  path === '/' || isWithin('/mediflow')
    ? 'work'
    : isWithin('/blog')
      ? 'notes'
      : isWithin('/about')
        ? 'bio'
        : undefined;

const active = (section: NavSection) => currentSection === section ? 'page' : undefined;
---
<header class="site-header">
  <div class="nav-shell">
    <a class="brand" href="/" aria-label="leonardopegollo.dev · home">
      <span class="brand-mark" aria-hidden="true"></span>
      <span class="brand-name">leonardopegollo<span>.dev</span></span>
    </a>

    <nav class="links" aria-label="Navigazione principale">
      <a class="nav-row" href="/" aria-current={active('work')}>Lavoro</a>
      <a class="nav-row" href="/blog" aria-current={active('notes')}>Note</a>
      <a class="nav-row" href="/about" aria-current={active('bio')}>Bio</a>
    </nav>
  </div>
</header>
