---
import type { IndexVisualKind } from '~/data/index';

interface Props {
  kind: IndexVisualKind;
}

const { kind } = Astro.props;
---

<div class={`index-visual index-visual--${kind}`} aria-hidden="true">
  {kind === 'gallery' && (
    <>
      <span class="gallery-a"></span>
      <span class="gallery-b"></span>
      <span class="gallery-c"></span>
      <span class="gallery-d"></span>
      <span class="gallery-e"></span>
    </>
  )}

  {kind === 'story' && (
    <>
      <span class="story-title"></span>
      <span class="story-copy story-copy-a"></span>
      <span class="story-copy story-copy-b"></span>
      <span class="story-chart story-chart-a"></span>
      <span class="story-chart story-chart-b"></span>
      <span class="story-chart story-chart-c"></span>
      <span class="story-chart story-chart-d"></span>
    </>
  )}

  {kind === 'notebook' && (
    <>
      <span class="notebook-rail"></span>
      <span class="notebook-line notebook-line-a"></span>
      <span class="notebook-line notebook-line-b"></span>
      <span class="notebook-line notebook-line-c"></span>
      <span class="notebook-plot"></span>
      <span class="notebook-dot notebook-dot-a"></span>
      <span class="notebook-dot notebook-dot-b"></span>
      <span class="notebook-dot notebook-dot-c"></span>
      <span class="notebook-dot notebook-dot-d"></span>
    </>
  )}

  {kind === 'atlas' && (
    <>
      <span class="atlas-axis"></span>
      <span class="atlas-line atlas-line-a"></span>
      <span class="atlas-line atlas-line-b"></span>
      <span class="atlas-label atlas-label-a"></span>
      <span class="atlas-label atlas-label-b"></span>
      <span class="atlas-label atlas-label-c"></span>
    </>
  )}

  {kind === 'river' && (
    <>
      <span class="river-card river-card-a"><i></i><i></i><i></i><i></i></span>
      <span class="river-card river-card-b"><i></i><i></i><i></i></span>
      <span class="river-card river-card-c"><i></i><i></i><i></i><i></i><i></i></span>
    </>
  )}

  {kind === 'product' && (
    <>
      <span class="product-sidebar"><i></i><i></i><i></i><i></i></span>
      <span class="product-main">
        <i class="product-heading"></i>
        <i class="product-row product-row-a"></i>
        <i class="product-row product-row-b"></i>
        <i class="product-row product-row-c"></i>
      </span>
    </>
  )}
</div>

<style>
  .index-visual{
    position:relative;
    min-height:240px;
    overflow:hidden;
    background:var(--surface-3);
  }
  .index-visual span,
  .index-visual i{ position:absolute; display:block; }

  .index-visual--gallery{ background:var(--surface-3); }
  .index-visual--gallery span{ border:1px solid rgba(17,20,23,.18); background:var(--surface); }
  .gallery-a{ inset:8% 55% 42% 5%; background:#0e6e5c !important; }
  .gallery-b{ inset:8% 5% 58% 48%; background:var(--amber) !important; }
  .gallery-c{ inset:48% 68% 6% 5%; background:#111417 !important; }
  .gallery-d{ inset:39% 32% 6% 35%; background:var(--surface) !important; }
  .gallery-e{ inset:47% 5% 6% 71%; background:var(--azure) !important; }

  .index-visual--story{ background:color-mix(in srgb, var(--amber), white 62%); }
  .story-title{ left:8%; top:11%; width:46%; height:15%; background:#111417; }
  .story-copy{ left:8%; height:2px; background:rgba(17,20,23,.46); }
  .story-copy-a{ top:33%; width:34%; }
  .story-copy-b{ top:38%; width:25%; }
  .story-chart{ bottom:12%; width:11%; background:var(--amber); transform-origin:bottom; }
  .story-chart-a{ left:48%; height:25%; }
  .story-chart-b{ left:60%; height:42%; }
  .story-chart-c{ left:72%; height:58%; }
  .story-chart-d{ left:84%; height:72%; }

  .index-visual--notebook{ background:var(--surface); }
  .notebook-rail{ inset:0 auto 0 0; width:12%; background:var(--surface-3); border-right:1px solid var(--line-strong); }
  .notebook-line{ left:20%; height:5px; background:var(--ink-2); }
  .notebook-line-a{ top:15%; width:47%; background:#0e6e5c; }
  .notebook-line-b{ top:23%; width:64%; }
  .notebook-line-c{ top:31%; width:36%; }
  .notebook-plot{ left:20%; right:8%; bottom:12%; height:42%; border-left:1px solid var(--ink-2); border-bottom:1px solid var(--ink-2); }
  .notebook-dot{ width:12px; height:12px; border-radius:50%; background:var(--azure); }
  .notebook-dot-a{ left:30%; bottom:22%; }
  .notebook-dot-b{ left:45%; bottom:31%; }
  .notebook-dot-c{ left:61%; bottom:27%; background:var(--amber); }
  .notebook-dot-d{ left:77%; bottom:44%; }

  .index-visual--atlas{ background:var(--surface-2); }
  .atlas-axis{ left:13%; right:8%; bottom:16%; height:1px; background:var(--ink-2); }
  .atlas-line{ left:13%; right:8%; height:3px; transform-origin:left center; }
  .atlas-line-a{ bottom:27%; background:#0e6e5c; transform:rotate(-11deg); }
  .atlas-line-b{ bottom:38%; background:var(--amber); transform:rotate(-24deg); }
  .atlas-label{ left:13%; height:6px; background:var(--ink-2); }
  .atlas-label-a{ top:13%; width:35%; background:#111417; }
  .atlas-label-b{ top:21%; width:53%; }
  .atlas-label-c{ top:27%; width:29%; }

  .index-visual--river{ display:flex; align-items:flex-end; gap:5%; padding:10%; background:var(--surface-3); }
  .river-card{ position:relative !important; flex:1; height:72%; background:var(--surface); border:1px solid rgba(17,20,23,.14); }
  .river-card:nth-child(2){ height:88%; }
  .river-card:nth-child(3){ height:63%; }
  .river-card i{ position:relative; left:auto; top:auto; width:58%; height:6px; margin:14px 12% 0; background:var(--ink-2); }
  .river-card i:first-child{ width:72%; height:10px; background:var(--azure); }

  .index-visual--product{ background:var(--ink-0); padding:8%; display:flex; gap:6%; }
  .product-sidebar{ position:relative !important; width:23%; height:100%; border-right:1px solid rgba(255,255,255,.16); }
  .product-sidebar i{ position:relative; width:62%; height:5px; margin:0 0 18px; background:var(--ink-2); }
  .product-sidebar i:first-child{ width:36%; background:#15c47a; }
  .product-main{ position:relative !important; flex:1; height:100%; }
  .product-heading{ position:relative !important; width:44%; height:12px; background:var(--line); margin-bottom:24px; }
  .product-row{ position:relative !important; width:100%; height:22%; margin-bottom:4%; border-top:1px solid rgba(255,255,255,.18); border-bottom:1px solid rgba(0,0,0,.3); }
  .product-row::before{ content:""; position:absolute; top:30%; left:0; width:52%; height:6px; background:var(--ink-2); }
  .product-row::after{ content:""; position:absolute; top:30%; right:0; width:12%; height:6px; background:#0e6e5c; }

  @media (max-width:680px){
    .index-visual{ min-height:190px; }
  }
</style>
