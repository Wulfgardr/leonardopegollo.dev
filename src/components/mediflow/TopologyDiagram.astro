---
interface Props {
  reveal?: boolean;
}

const { reveal = true } = Astro.props;
---

<figure
  class:list={['topology', { reveal }]}
  aria-labelledby="topology-title"
  aria-describedby="topology-description topology-boundary"
>
  <figcaption class="topology-intro">
    <h3 id="topology-title">Tre ingressi, un solo nodo autorevole.</h3>
    <p id="topology-description">
      Ogni client segue un percorso esplicito verso il Mac home-base. I client paired
      non accedono mai direttamente al database.
    </p>
  </figcaption>

  <div class="topology-grid" role="group" aria-label="Percorsi dei client verso il Mac home-base">
    <span class="axis axis-entry">Ingresso</span>
    <span class="axis axis-route">Percorso</span>
    <span class="axis axis-host">Mac home-base · nodo autorevole</span>

    <article class="endpoint endpoint-web">
      <strong>Browser web locale</strong>
      <span>UI clinica · cifratura lato client</span>
    </article>
    <div class="transport transport-web">
      <span>HTTP loopback · :3000</span>
    </div>

    <article class="endpoint endpoint-native">
      <strong>Client macOS locale</strong>
      <span>Sessione sicurezza · cifratura locale</span>
    </article>
    <div class="transport transport-native">
      <span>HTTPS loopback · :3443</span>
    </div>

    <article class="endpoint endpoint-paired">
      <strong>iPhone, iPad o Mac paired</strong>
      <span>Opt-in · LAN fidata · capability esplicite</span>
    </article>
    <div class="transport transport-paired">
      <span>HTTPS LAN · :3443</span>
    </div>

    <div class="api api-web">
      <strong>Web API</strong>
      <code>/api/*</code>
      <span>session cookie</span>
    </div>
    <div class="api api-native">
      <strong>TLS proxy → Native API</strong>
      <code>/api/v1/*</code>
      <span>bearer token locale</span>
    </div>
    <div class="api api-network">
      <strong>TLS proxy → Network API</strong>
      <code>/api/v1/network/*</code>
      <span>pairing + sessione · scritture versionate</span>
    </div>

  </div>

  <section class="home-resources" aria-label="Risorse locali del Mac home-base">
    <h4>Dentro il Mac home-base</h4>
    <article class="resource storage">
      <strong>medical.db</strong>
      <span>SQLite autorevole · campi clinici sensibili cifrati</span>
    </article>
    <article class="resource backup">
      <strong>Backup locale</strong>
      <span>artifact governato · retention configurabile</span>
    </article>
    <article class="resource services">
      <strong>Servizi locali opzionali</strong>
      <span>Ollama :11434 · ICD-11 :8888</span>
      <small>OpenMed :18080 solo shadow evaluation</small>
    </article>
    <article class="resource security">
      <strong>Credenziali e TLS</strong>
      <span>token locale 0600 · percorsi certificato configurabili</span>
    </article>
  </section>

  <p class="topology-boundary" id="topology-boundary">
    <strong>Confine operativo:</strong> loopback per il lavoro sul Mac; rete locale fidata
    soltanto in modalità <code>network-home-base</code>. Nessun cloud e nessun multi-master
    per impostazione predefinita.
  </p>
</figure>

<style>
  .topology{
    margin:0;
    border:1px solid var(--line-strong);
    background:var(--surface);
  }
  .topology-intro{
    display:grid;
    grid-template-columns:minmax(0, .8fr) minmax(280px, 1.2fr);
    gap:var(--space-8);
    align-items:start;
    padding:var(--space-6);
    border-bottom:1px solid var(--line);
  }
  .topology-intro h3{
    margin:0;
    font-size:clamp(1.3rem, 2vw, 1.7rem);
  }
  .topology-intro p{
    max-width:60ch;
    margin:0;
    justify-self:end;
  }

  .topology-grid{
    display:grid;
    grid-template-columns:minmax(190px, .8fr) minmax(180px, .72fr) minmax(360px, 1.48fr);
    grid-template-rows:auto repeat(3, minmax(92px, auto));
  }
  .axis{
    padding:var(--space-3) var(--space-4);
    border-bottom:1px solid var(--line);
    color:var(--ink-3);
    font:600 11px/1.3 var(--font-technical);
    text-transform:uppercase;
  }
  .axis-route,
  .axis-host{
    border-left:1px solid var(--line);
  }
  .axis-host{
    color:var(--mint);
  }

  .endpoint{
    display:flex;
    flex-direction:column;
    justify-content:center;
    gap:var(--space-1);
    min-width:0;
    padding:var(--space-4);
    border-bottom:1px solid var(--line);
  }
  .endpoint strong,
  .api strong,
  .resource strong{
    color:var(--ink-0);
    font:700 15px/1.35 var(--font-display);
  }
  .endpoint span,
  .api span,
  .resource span,
  .resource small{
    color:var(--ink-2);
    font-size:.8rem;
    line-height:1.45;
  }

  .transport{
    position:relative;
    display:grid;
    place-items:center;
    min-width:0;
    padding:var(--space-4);
    border-bottom:1px solid var(--line);
    border-left:1px solid var(--line);
  }
  .transport::before{
    content:"";
    position:absolute;
    right:0;
    left:0;
    top:50%;
    height:1px;
    background:var(--line-strong);
  }
  .transport::after{
    content:"";
    position:absolute;
    right:-1px;
    top:calc(50% - 4px);
    width:6px;
    height:8px;
    background:var(--mint);
    clip-path:polygon(0 0, 100% 50%, 0 100%);
  }
  .transport span{
    position:relative;
    z-index:1;
    padding:var(--space-1) var(--space-2);
    background:var(--surface);
    color:var(--ink-2);
    font:600 11px/1.35 var(--font-technical);
    text-align:center;
  }

  .endpoint-web{ grid-column:1; grid-row:2; }
  .transport-web{ grid-column:2; grid-row:2; }
  .endpoint-native{ grid-column:1; grid-row:3; }
  .transport-native{ grid-column:2; grid-row:3; }
  .endpoint-paired{ grid-column:1; grid-row:4; border-bottom:0; }
  .transport-paired{ grid-column:2; grid-row:4; border-bottom:0; }

  .api{
    grid-column:3;
    border-left:1px solid var(--line-strong);
    background:rgba(14,110,92,.025);
  }
  .api-web{ grid-row:2; }
  .api-native{ grid-row:3; }
  .api-network{ grid-row:4; }
  .api{
    display:grid;
    grid-template-columns:minmax(0, 1fr) auto;
    gap:var(--space-1) var(--space-4);
    align-content:center;
    min-width:0;
    padding:var(--space-4);
    border-bottom:1px solid var(--line);
  }
  .api code{
    grid-column:2;
    grid-row:1 / 3;
    align-self:center;
    color:var(--mint-ink);
    font-size:.8rem;
    overflow-wrap:anywhere;
  }
  .api span{
    grid-column:1;
  }

  .home-resources{
    display:grid;
    grid-template-columns:repeat(4, minmax(0, 1fr));
    padding:0;
    border-top:1px solid var(--line-strong);
    background:var(--surface-2);
  }
  .home-resources h4{
    grid-column:1 / -1;
    margin:0;
    padding:var(--space-3) var(--space-4);
    border-bottom:1px solid var(--line);
    color:var(--mint);
    font:600 11px/1.3 var(--font-technical);
    text-transform:uppercase;
    letter-spacing:0;
  }
  .resource{
    display:flex;
    flex-direction:column;
    gap:var(--space-1);
    min-width:0;
    padding:var(--space-4);
    border-right:1px solid var(--line);
  }
  .resource:last-child{ border-right:0; }
  .resource.storage strong,
  .resource.backup strong{ color:var(--amber-ink); }
  .resource.services strong{ color:var(--azure); }

  .topology-boundary{
    margin:0;
    padding:var(--space-4) var(--space-6);
    border-top:1px solid var(--line-strong);
    color:var(--ink-2);
    font-size:13px;
  }
  .topology-boundary strong{ color:var(--ink-0); }

  @media (max-width:860px){
    .topology-intro{
      grid-template-columns:1fr;
      gap:var(--space-2);
    }
    .topology-intro p{ justify-self:start; }
    .topology-grid{
      grid-template-columns:minmax(160px, .8fr) minmax(150px, .7fr) minmax(300px, 1.4fr);
      overflow-x:auto;
    }
  }

  @media (max-width:680px){
    .topology-intro,
    .topology-boundary{ padding:var(--space-4); }
    .topology-grid{
      display:flex;
      flex-direction:column;
      overflow:visible;
    }
    .axis-entry,
    .axis-route{ display:none; }
    .axis-host{ display:none; }
    .endpoint{
      padding:var(--space-4);
      border-bottom:0;
    }
    .endpoint-web{ order:0; }
    .transport-web{ order:1; }
    .api-web{ order:2; }
    .endpoint-native{ order:3; }
    .transport-native{ order:4; }
    .api-native{ order:5; }
    .endpoint-paired{ order:6; }
    .transport-paired{ order:7; }
    .api-network{ order:8; }
    .transport{
      min-height:42px;
      padding:var(--space-2) var(--space-4);
      border-left:0;
      border-bottom:0;
    }
    .transport::before{
      top:0;
      bottom:0;
      left:var(--space-6);
      width:1px;
      height:auto;
    }
    .transport::after{
      right:auto;
      bottom:-1px;
      left:calc(var(--space-6) - 4px);
      top:auto;
      width:8px;
      height:6px;
      clip-path:polygon(0 0, 100% 0, 50% 100%);
    }
    .transport span{
      justify-self:start;
      margin-left:var(--space-6);
      text-align:left;
    }
    .api{
      border-top:1px solid var(--line-strong);
      border-left:0;
      grid-template-columns:1fr;
      min-height:0;
    }
    .api code,
    .api span{
      grid-column:1;
      grid-row:auto;
    }
    .home-resources{
      grid-template-columns:1fr;
      border-left:0;
    }
    .resource{
      border-right:0;
      border-bottom:1px solid var(--line);
    }
    .resource:last-child{ border-bottom:0; }
  }
</style>
