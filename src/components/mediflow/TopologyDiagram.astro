---
interface Props {
  reveal?: boolean;
  lang?: 'it' | 'en';
}

const { reveal = true, lang = 'it' } = Astro.props;
const copy = lang === 'en'
  ? {
      title: 'Towards 0.8.6 · One node, more ways in.',
      description: 'The local runtime can run on Mac, Windows or Linux. Associated apps and agents go through authorised services without opening the database.',
      ariaLabel: 'Routes from Web, associated apps and Mini or MCP to the MediFlow node',
      entry: 'Entry',
      route: 'Route',
      node: 'MediFlow node · data authority',
      browser: 'Local browser',
      browserDetail: 'Folders, agenda, documents and settings',
      nativeApps: 'Associated Mac, iPhone and iPad apps',
      nativeAppsDetail: 'Online access; encrypted cache limited to list and last profile',
      explicitPairing: 'HTTPS · explicit pairing',
      agents: 'Mini and MCP agents',
      agentsDetail: 'Reads and proposals in the context authorised by Web',
      supervisor: 'Local Supervisor · inherited IPC',
      webApi: 'Web API',
      webApiDetail: 'Web session · version checks',
      clientApis: 'Associated-client APIs',
      clientApisDetail: 'Pairing + native operator session + authorised capabilities',
      aipServices: 'AIP application services',
      authenticatedRpc: 'Authenticated RPC over IPC',
      aipServicesDetail: 'Limits, revocation and audit · no authority supplied by caller',
      resourcesLabel: 'Resources in the local node',
      resourcesTitle: 'Inside the local node',
      sqlite: 'Authoritative SQLite',
      sqliteDetail: 'Sensitive clinical fields encrypted · versioned writes',
      backup: 'Administrative backup',
      backupDetail: 'Content verification and controlled restore',
      optionalServices: 'Optional services',
      optionalServicesDetail: 'Ollama · ATHENA/MLX on a compatible Mac',
      who: 'WHO: code search and verification through a local service to configure',
      access: 'Distinct access paths',
      accessDetail: 'The paired device does not replace the operator login',
      boundaryLabel: 'Operational boundary:',
      boundary: 'the local network is optional; cloud and AI generation are disabled by default. No offline writes or multi-master synchronisation. Mini has been tested with the real Supervisor and Web server on Mac for reads and proposals without clinical saves. Tests on the other platforms and signed distribution remain separate. Version 0.8.6 is still in preparation.',
    }
  : {
      title: 'Verso la 0.8.6 · Un nodo, più accessi.',
      description: 'Il runtime locale può essere ospitato su Mac, Windows o Linux. App associate e agenti passano dai servizi autorizzati, senza aprire il database.',
      ariaLabel: 'Percorsi Web, app associate e Mini o MCP verso il nodo MediFlow',
      entry: 'Ingresso',
      route: 'Percorso',
      node: 'Nodo MediFlow · autorità sui dati',
      browser: 'Browser locale',
      browserDetail: 'Cartelle, agenda, documenti e impostazioni',
      nativeApps: 'App Mac, iPhone e iPad associate',
      nativeAppsDetail: 'Accesso online; cache cifrata limitata a lista e ultimo profilo',
      explicitPairing: 'HTTPS · associazione esplicita',
      agents: 'Mini e agenti MCP',
      agentsDetail: 'Letture e proposte nel contesto autorizzato dal Web',
      supervisor: 'Supervisor locale · IPC ereditato',
      webApi: 'API Web',
      webApiDetail: 'Sessione Web · controlli di versione',
      clientApis: 'API dei client associati',
      clientApisDetail: 'Pairing + sessione operatore nativa + capacità autorizzate',
      aipServices: 'Servizi applicativi AIP',
      authenticatedRpc: 'RPC autenticata su IPC',
      aipServicesDetail: 'Limiti, revoca e audit · nessuna autorità fornita dal chiamante',
      resourcesLabel: 'Risorse del nodo locale',
      resourcesTitle: 'Dentro il nodo locale',
      sqlite: 'SQLite autorevole',
      sqliteDetail: 'Campi clinici sensibili cifrati · scritture versionate',
      backup: 'Backup amministrativo',
      backupDetail: 'Verifica del contenuto e ripristino controllato',
      optionalServices: 'Servizi facoltativi',
      optionalServicesDetail: 'Ollama · ATHENA/MLX su Mac compatibile',
      who: 'WHO: ricerca e verifica dei codici con un servizio locale da configurare',
      access: 'Accessi distinti',
      accessDetail: 'Il dispositivo associato non sostituisce il login dell’operatore',
      boundaryLabel: 'Confine operativo:',
      boundary: 'la rete locale è facoltativa; cloud e generazione AI sono disattivati per default. Nessuna scrittura offline o sincronizzazione multi-master. Mini è stato provato con il Supervisor e il server Web reali su Mac, per letture e proposte senza salvataggi clinici. Le prove delle altre piattaforme e la distribuzione firmata restano separate. La 0.8.6 è ancora in preparazione.',
    };
---

<figure
  class:list={['topology', { reveal }]}
  aria-labelledby="topology-title"
  aria-describedby="topology-description topology-boundary"
>
  <figcaption class="topology-intro">
    <h3 id="topology-title">{copy.title}</h3>
    <p id="topology-description">{copy.description}</p>
  </figcaption>

  <div class="topology-grid" role="group" aria-label={copy.ariaLabel}>
    <span class="axis axis-entry">{copy.entry}</span>
    <span class="axis axis-route">{copy.route}</span>
    <span class="axis axis-host">{copy.node}</span>

    <article class="endpoint endpoint-web">
      <strong>{copy.browser}</strong>
      <span>{copy.browserDetail}</span>
    </article>
    <div class="transport transport-web"><span>HTTP loopback</span></div>
    <article class="endpoint endpoint-native">
      <strong>{copy.nativeApps}</strong>
      <span>{copy.nativeAppsDetail}</span>
    </article>
    <div class="transport transport-native"><span>{copy.explicitPairing}</span></div>
    <article class="endpoint endpoint-paired">
      <strong>{copy.agents}</strong>
      <span>{copy.agentsDetail}</span>
    </article>
    <div class="transport transport-paired"><span>{copy.supervisor}</span></div>

    <div class="api api-web">
      <strong>{copy.webApi}</strong><code>/api/*</code>
      <span>{copy.webApiDetail}</span>
    </div>
    <div class="api api-native">
      <strong>{copy.clientApis}</strong><code>/api/v1/network/*</code>
      <span>{copy.clientApisDetail}</span>
    </div>
    <div class="api api-network">
      <strong>{copy.aipServices}</strong><code>{copy.authenticatedRpc}</code>
      <span>{copy.aipServicesDetail}</span>
    </div>
  </div>

  <section class="home-resources" aria-label={copy.resourcesLabel}>
    <h4>{copy.resourcesTitle}</h4>
    <article class="resource storage">
      <strong>{copy.sqlite}</strong>
      <span>{copy.sqliteDetail}</span>
    </article>
    <article class="resource backup">
      <strong>{copy.backup}</strong>
      <span>{copy.backupDetail}</span>
    </article>
    <article class="resource services">
      <strong>{copy.optionalServices}</strong>
      <span>{copy.optionalServicesDetail}</span>
      <small>{copy.who}</small>
    </article>
    <article class="resource security">
      <strong>{copy.access}</strong>
      <span>{copy.accessDetail}</span>
    </article>
  </section>

  <p class="topology-boundary" id="topology-boundary">
    <strong>{copy.boundaryLabel}</strong> {copy.boundary}
  </p>
</figure>

<style>
  .topology{
    margin:0;
    border:1px solid var(--line-strong);
    background:var(--surface);
  }
  .topology-intro{
    display:grid;
    grid-template-columns:minmax(0, .8fr) minmax(280px, 1.2fr);
    gap:var(--space-8);
    align-items:start;
    padding:var(--space-6);
    border-bottom:1px solid var(--line);
  }
  .topology-intro h3{
    margin:0;
    font-size:clamp(1.3rem, 2vw, 1.7rem);
  }
  .topology-intro p{
    max-width:60ch;
    margin:0;
    justify-self:end;
  }

  .topology-grid{
    display:grid;
    grid-template-columns:minmax(0, .85fr) minmax(160px, .7fr) minmax(0, 1.45fr);
    grid-template-rows:auto repeat(3, minmax(92px, auto));
  }
  .axis{
    padding:var(--space-3) var(--space-4);
    border-bottom:1px solid var(--line);
    color:var(--ink-3);
    font:600 11px/1.3 var(--font-technical);
    text-transform:uppercase;
  }
  .axis-route,
  .axis-host{
    border-left:1px solid var(--line);
  }
  .axis-host{
    color:var(--mint);
  }

  .endpoint{
    display:flex;
    flex-direction:column;
    justify-content:center;
    gap:var(--space-1);
    min-width:0;
    padding:var(--space-4);
    border-bottom:1px solid var(--line);
  }
  .endpoint strong,
  .api strong,
  .resource strong{
    color:var(--ink-0);
    font:700 15px/1.35 var(--font-display);
  }
  .endpoint span,
  .api span,
  .resource span,
  .resource small{
    color:var(--ink-2);
    font-size:.875rem;
    line-height:1.45;
  }

  .transport{
    position:relative;
    display:grid;
    place-items:center;
    min-width:0;
    padding:var(--space-4);
    border-bottom:1px solid var(--line);
    border-left:1px solid var(--line);
  }
  .transport::before{
    content:"";
    position:absolute;
    right:0;
    left:0;
    top:calc(50% + 18px);
    height:2px;
    background:var(--line-strong);
  }
  .transport::after{
    content:"";
    position:absolute;
    right:-1px;
    top:calc(50% + 15px);
    width:6px;
    height:8px;
    background:var(--mint);
    clip-path:polygon(0 0, 100% 50%, 0 100%);
  }
  .transport span{
    position:relative;
    z-index:1;
    padding:var(--space-1) var(--space-2);
    background:transparent;
    color:var(--ink-2);
    font:600 12px/1.35 var(--font-technical);
    transform:translateY(-10px);
    text-align:center;
  }

  .endpoint-web{ grid-column:1; grid-row:2; }
  .transport-web{ grid-column:2; grid-row:2; }
  .endpoint-native{ grid-column:1; grid-row:3; }
  .transport-native{ grid-column:2; grid-row:3; }
  .endpoint-paired{ grid-column:1; grid-row:4; border-bottom:0; }
  .transport-paired{ grid-column:2; grid-row:4; border-bottom:0; }

  .api{
    grid-column:3;
    border-left:1px solid var(--line-strong);
    background:rgba(14,110,92,.025);
  }
  .api-web{ grid-row:2; }
  .api-native{ grid-row:3; }
  .api-network{ grid-row:4; }
  .api{
    display:grid;
    grid-template-columns:minmax(0, 1fr);
    gap:var(--space-1) var(--space-4);
    align-content:center;
    min-width:0;
    padding:var(--space-4);
    border-bottom:1px solid var(--line);
  }
  .api code{
    grid-column:1;
    grid-row:auto;
    align-self:center;
    color:var(--mint-ink);
    font-size:.875rem;
    overflow-wrap:anywhere;
  }
  .api span{
    grid-column:1;
  }

  .home-resources{
    display:grid;
    grid-template-columns:repeat(4, minmax(0, 1fr));
    padding:0;
    border-top:1px solid var(--line-strong);
    background:var(--surface-2);
  }
  .home-resources h4{
    grid-column:1 / -1;
    margin:0;
    padding:var(--space-3) var(--space-4);
    border-bottom:1px solid var(--line);
    color:var(--mint);
    font:600 11px/1.3 var(--font-technical);
    text-transform:uppercase;
    letter-spacing:0;
  }
  .resource{
    display:flex;
    flex-direction:column;
    gap:var(--space-1);
    min-width:0;
    padding:var(--space-4);
    border-right:1px solid var(--line);
  }
  .resource:last-child{ border-right:0; }
  .resource.storage strong,
  .resource.backup strong{ color:var(--amber-ink); }
  .resource.services strong{ color:var(--azure); }

  .topology-boundary{
    margin:0;
    padding:var(--space-4) var(--space-6);
    border-top:1px solid var(--line-strong);
    color:var(--ink-2);
    font-size:13px;
  }
  .topology-boundary strong{ color:var(--ink-0); }

  @media (max-width:860px){
    .topology-intro{
      grid-template-columns:1fr;
      gap:var(--space-2);
    }
    .topology-intro p{ justify-self:start; }
    .topology-grid{
      grid-template-columns:minmax(0, 1fr);
    }
  }

  @media (max-width:1000px){
    .topology-intro,
    .topology-boundary{ padding:var(--space-4); }
    .topology-grid{
      display:flex;
      flex-direction:column;
      overflow:visible;
    }
    .axis-entry,
    .axis-route{ display:none; }
    .axis-host{ display:none; }
    .endpoint{
      padding:var(--space-4);
      border-bottom:0;
    }
    .endpoint-web{ order:0; }
    .transport-web{ order:1; }
    .api-web{ order:2; }
    .endpoint-native{ order:3; }
    .transport-native{ order:4; }
    .api-native{ order:5; }
    .endpoint-paired{ order:6; }
    .transport-paired{ order:7; }
    .api-network{ order:8; }
    .transport{
      min-height:42px;
      padding:var(--space-2) var(--space-4);
      border-left:0;
      border-bottom:0;
    }
    .transport::before{
      top:0;
      bottom:0;
      left:var(--space-6);
      width:1px;
      height:auto;
    }
    .transport::after{
      right:auto;
      bottom:-1px;
      left:calc(var(--space-6) - 4px);
      top:auto;
      width:8px;
      height:6px;
      clip-path:polygon(0 0, 100% 0, 50% 100%);
    }
    .transport span{
      transform:none;
      justify-self:start;
      margin-left:var(--space-6);
      text-align:left;
    }
    .api{
      border-top:1px solid var(--line-strong);
      border-left:0;
      grid-template-columns:1fr;
      min-height:0;
    }
    .api code,
    .api span{
      grid-column:1;
      grid-row:auto;
    }
    .home-resources{
      grid-template-columns:1fr;
      border-left:0;
    }
    .resource{
      border-right:0;
      border-bottom:1px solid var(--line);
    }
    .resource:last-child{ border-bottom:0; }
  }
</style>
